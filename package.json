  "peerDependencies": { "react": ">=17", "@types/react": ">=17" },
  "peerDependenciesMeta": { "@types/react": { "optional": true } },
  "devDependencies": { "@types/react": "^18.0.0", "typescript": "^5.4.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/regisrex/magnesium.git" },
  "bugs": { "url": "https://github.com/regisrex/magnesium/issues" },
  "homepage": "https://github.com/regisrex/magnesium#readme",
  "publishConfig": { "access": "public" }
